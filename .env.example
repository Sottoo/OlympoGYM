# ─────────────────────────────────────────────────────────────
# Copia este archivo como .env.local y llena los valores.
# Si dejas vacías las variables de Supabase, la app arranca en
# MODO DEMO con datos de ejemplo guardados en memoria.
#
# Al generar el instalador, estos valores quedan dentro del
# programa. Por eso aquí NO va la service_role key.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Datos del gimnasio que aparecen en los mensajes de WhatsApp
NEXT_PUBLIC_NOMBRE_GIMNASIO="Olimpo GYM"
ZONA_HORARIA=America/Mexico_City
