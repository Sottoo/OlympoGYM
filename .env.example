# ─────────────────────────────────────────────────────────────
# Opcional. Copia este archivo como .env.local para cambiar estos
# valores. La base de datos es local (SQLite): no hay claves ni
# servicios en línea que configurar.
# ─────────────────────────────────────────────────────────────

# Nombre que aparece en el programa y en los mensajes de WhatsApp
NEXT_PUBLIC_NOMBRE_GIMNASIO="Olimpo GYM"
ZONA_HORARIA=America/Mexico_City

# Solo para desarrollo: dónde guardar la base y los respaldos.
# El programa instalado usa %APPDATA%\Olimpo GYM\datos y
# Documentos\Olimpo GYM\Respaldos.
# RUTA_DATOS=
# RUTA_RESPALDOS=
