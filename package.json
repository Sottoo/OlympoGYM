{
  "name": "proyecto-gimnasio",
  "productName": "Olimpo GYM",
  "version": "1.0.0-beta.44",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "rapido": "next build && next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:escritorio": "next build && node scripts/preparar-escritorio.mjs",
    "escritorio": "electron .",
    "escritorio:dev": "electron . --dev",
    "abrir": "npm run build:escritorio && electron .",
    "instalador": "npm run build:escritorio && electron-builder --win && node scripts/limpiar-instaladores.mjs",
    "instalador:docker": "npm run build:escritorio && node scripts/instalador-docker.mjs && node scripts/limpiar-instaladores.mjs",
    "publicar": "node scripts/publicar-version.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "koffi": "^3.3.7",
    "next": "15.5.26",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "description": "Sistema de administración de Olimpo GYM",
  "author": "Olimpo GYM",
  "main": "electron/arranque.cjs",
  "build": {
    "appId": "mx.olimpogym.panel",
    "productName": "Olimpo GYM",
    "directories": {
      "output": "dist-escritorio",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Olimpo GYM",
      "uninstallDisplayName": "Olimpo GYM",
      "installerLanguages": [
        "es_ES"
      ],
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh"
    },
    "afterPack": "scripts/despues-de-empaquetar.cjs",
    "copyright": "© 2026 Olimpo GYM",
    "electronLanguages": [
      "es",
      "es-419",
      "en-US"
    ]
  }
}
