{
  "name": "proyecto-gimnasio",
  "productName": "Olimpo GYM",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:escritorio": "next build && node scripts/preparar-escritorio.mjs",
    "escritorio": "electron .",
    "escritorio:dev": "electron . --dev",
    "instalador": "npm run build:escritorio && electron-builder --win"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.0",
    "next": "15.5.26",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "description": "Sistema de administración de Olimpo GYM",
  "author": "Olimpo GYM",
  "main": "electron/main.cjs",
  "build": {
    "appId": "mx.olimpogym.panel",
    "productName": "Olimpo GYM",
    "directories": {
      "output": "dist-escritorio",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Olimpo GYM"
    },
    "afterPack": "scripts/despues-de-empaquetar.cjs"
  }
}
